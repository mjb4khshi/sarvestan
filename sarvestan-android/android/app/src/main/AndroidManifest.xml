        </activity-alias>

        <activity-alias
            android:name=".MainActivityStealth"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_stealth"
            android:roundIcon="@mipmap/ic_launcher_stealth_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".SarvestanWidgetProvider"
            android:label="@string/widget_combo_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sarvestan_widget_info" />
        </receiver>

        <receiver
            android:name=".SarvestanGpaWidgetProvider"
            android:label="@string/widget_gpa_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sarvestan_widget_gpa_info" />
        </receiver>

        <receiver
            android:name=".SarvestanClassWidgetProvider"
            android:label="@string/widget_class_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sarvestan_widget_class_info" />
        </receiver>

        <receiver
            android:name=".ClassReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ir.mjbakhshi.sarvestan.CLASS_REMINDER" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- یادآوری کلاس و حالت مزاحم نشوید -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- ساخت آلارم در اپ ساعت -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SET_ALARM" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <package android:name="com.miui.deskclock" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.huawei.deskclock" />
        <package android:name="com.honor.deskclock" />
        <package android:name="com.coloros.alarm" />
        <package android:name="com.oppo.alarm" />
        <package android:name="com.heytap.clock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.vivo.alarmclock" />
        <package android:name="com.android.bbkclock" />
    </queries>
</manifest>
