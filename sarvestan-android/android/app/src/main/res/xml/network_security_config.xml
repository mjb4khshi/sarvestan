<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ut.ac.ir</domain>
        <domain includeSubdomains="true">kntu.ac.ir</domain>
        <domain includeSubdomains="true">sbu.ac.ir</domain>
        <domain includeSubdomains="true">aut.ac.ir</domain>
        <domain includeSubdomains="true">iust.ac.ir</domain>
        <domain includeSubdomains="true">srttu.ac.ir</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
