{
  "manifest_version": 3,
  "name": "سروستان | Sarvestan - افزونه هوشمند سامانه‌های دانشگاهی",
  "version": "2.1.1",
  "description": "داشبورد مدرن، هوشمند و سریع سامانه‌های بهستان و گلستان دانشگاه‌ها (خواجه نصیر، امیرکبیر، بهشتی، تهران، علم و صنعت) با دیزاین‌سیستم سرو",
  "author": "MJ",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "سروستان - داشبورد مدرن سامانه بهستان و گلستان",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.kntu.ac.ir/*",
    "*://behestan.kntu.ac.ir/*",
    "*://*.aut.ac.ir/*",
    "*://portal.aut.ac.ir/*",
    "*://*.sbu.ac.ir/*",
    "*://ems.sbu.ac.ir/*",
    "*://*.ut.ac.ir/*",
    "*://ems2.ut.ac.ir/*",
    "*://ems1.ut.ac.ir/*",
    "*://*.iust.ac.ir/*",
    "*://golestan.iust.ac.ir/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.kntu.ac.ir/*",
        "*://behestan.kntu.ac.ir/*",
        "*://*.aut.ac.ir/*",
        "*://portal.aut.ac.ir/*",
        "*://*.sbu.ac.ir/*",
        "*://ems.sbu.ac.ir/*",
        "*://*.ut.ac.ir/*",
        "*://ems2.ut.ac.ir/*",
        "*://ems1.ut.ac.ir/*",
        "*://*.iust.ac.ir/*",
        "*://golestan.iust.ac.ir/*"
      ],
      "js": [
        "behestanInterceptor.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.kntu.ac.ir/*",
        "*://behestan.kntu.ac.ir/*",
        "*://*.aut.ac.ir/*",
        "*://portal.aut.ac.ir/*",
        "*://*.sbu.ac.ir/*",
        "*://ems.sbu.ac.ir/*",
        "*://*.ut.ac.ir/*",
        "*://ems2.ut.ac.ir/*",
        "*://ems1.ut.ac.ir/*",
        "*://*.iust.ac.ir/*",
        "*://golestan.iust.ac.ir/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "behestanInterceptor.js",
        "fonts/*",
        "icons/*",
        "index.html",
        "assets/*",
        "*.png",
        "*.svg",
        "*.woff2"
      ],
      "matches": [
        "*://*.kntu.ac.ir/*",
        "*://behestan.kntu.ac.ir/*",
        "*://*.aut.ac.ir/*",
        "*://portal.aut.ac.ir/*",
        "*://*.sbu.ac.ir/*",
        "*://ems.sbu.ac.ir/*",
        "*://*.ut.ac.ir/*",
        "*://ems2.ut.ac.ir/*",
        "*://ems1.ut.ac.ir/*",
        "*://*.iust.ac.ir/*",
        "*://golestan.iust.ac.ir/*"
      ]
    }
  ]
}